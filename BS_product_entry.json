      "parameters": {
        "jsCode": "const rows = items.map(i => i.json);\n\nrows.sort((a, b) => {\n  const da = new Date(a[\"order date\"]);\n  const db = new Date(b[\"order date\"]);\n\n  if (isNaN(da) && isNaN(db)) return 0;\n  if (isNaN(da)) return 1;\n  if (isNaN(db)) return -1;\n\n  return da - db;\n});\n\nreturn rows.map(r => ({ json: r }));"
