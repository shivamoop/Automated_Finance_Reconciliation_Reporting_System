    {
      "parameters": {
        "jsCode": "const newReceipts = $input.all();\nconst ledgerItems = $items(\"Payment_Status\");\n\n\nconst existingKeys = new Set(\n  ledgerItems.map(i => String(i.json.voucher_no || \"\").trim())\n);\n\nconst seenInBatch = new Set();\nconst finalOutput = [];\n\nfor (const item of newReceipts) {\n  // 2. Extract the incoming field 'voucher_no' from your input node\n  const key = String(item.json.voucher_no || \"\").trim();\n  \n  // 3. Skip if the key is empty\n  if (!key) continue;\n\n  // 4. Skip if already exists in the Google Sheet (ledger)\n  if (existingKeys.has(key)) {\n    continue;\n  }\n\n  // 5. Skip if it's a duplicate within the current incoming batch\n  if (seenInBatch.has(key)) {\n    continue;\n  }\n\n  // If it passes all checks, add it to the final output\n  seenInBatch.add(key);\n  finalOutput.push(item);\n}\n\n/** * If finalOutput has items, they are sent to the next node.\n * If finalOutput is empty, it returns [], which stops the \n * \"Append row in sheet2\" node from executing.\n */\nreturn finalOutput;"
      },
