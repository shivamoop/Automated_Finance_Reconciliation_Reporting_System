    {
      "parameters": {
        "jsCode": "const newReceipts = $input.all();\nconst ledgerItems = $items(\"Receipt_Ledger\");\n\nconst existingKeys = new Set(\n  ledgerItems.map(i => String(i.json.receipt_key || \"\").trim())\n);\n\nconst seenInBatch = new Set();\nconst finalOutput = [];\nconst debug = [];\n\nfor (const item of newReceipts) {\n\n  const key = String(item.json.receipt_key || \"\").trim();\n  if (!key) continue;\n\n  if (existingKeys.has(key)) {\n    debug.push({ reason: \"Already in Ledger\", key });\n    continue;\n  }\n\n  if (seenInBatch.has(key)) {\n    debug.push({ reason: \"Duplicate in Batch\", key });\n    continue;\n  }\n\n  seenInBatch.add(key);\n  finalOutput.push(item);\n}\n\nreturn finalOutput.length\n  ? finalOutput\n  : debug.map(d => ({ json: d }));\n"
      },
