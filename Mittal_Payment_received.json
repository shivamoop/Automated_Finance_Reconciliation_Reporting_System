            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "ae1454f9-fc13-4a3a-823e-d3317faf220c",
              "leftValue": "= {{ $json.voucher_type }}",
              "rightValue": "Sales",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
