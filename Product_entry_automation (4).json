    {
      "parameters": {
        "jsCode": "// Skip first 10 rows\nconst rows = items.slice(10);\n\n// Desired headers\nconst headers = [\n  \"Date\",\n  \"Particulars\",\n  \"Vch Type\",\n  \"Vch No.\",\n  \"Debit Amount\",\n  \"Credit Amount\",\n  \"undefined\",\n  \"undefined\",\n  \"undefined\",\n  \"undefined\"\n];\n\n// Excel serial → ISO date\nfunction excelDateToISO(serial) {\n  if (typeof serial !== \"number\") return serial;\n  const base = new Date(Date.UTC(1899, 11, 30));\n  return new Date(base.getTime() + serial * 86400000)\n    .toISOString()\n    .slice(0, 10);\n}\n\nconst output = rows.map(item => {\n  const values = Object.values(item.json);\n  const newRow = {};\n\n  headers.forEach((h, idx) => {\n    let val = values[idx] ?? null;\n\n    // ✅ Correct Date column\n    if (h === \"Date\") {\n      val = excelDateToISO(val);\n    }\n\n    newRow[h] = val;\n  });\n\n  return { json: newRow };\n});\n\nreturn output;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        448
      ],
      "id": "aedb4ea4-4b79-42d5-aefb-251a93c8743d",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\n\nlet currentDate = null;\nlet currentParty = null;\nlet inInvoice = false;\n\nconst isISODate = v =>\n  typeof v === \"string\" && /^\\d{4}-\\d{2}-\\d{2}$/.test(v);\n\n// ✅ Units OPTIONAL now\nconst qtyRegex  = /^[\\d.]+(\\s*(nos|ltr|kg|pcs))?$/i;\nconst rateRegex = /^[\\d.]+(\\s*\\/\\s*(nos|ltr|kg|pcs))?$/i;\n\nfor (const item of items) {\n  const r = item.json;\n\n  /* 1️⃣ Detect invoice header */\n  if (isISODate(r.Date)) {\n    inInvoice = r[\"Vch Type\"] === \"Tax Invoice\";\n    currentDate  = inInvoice ? r.Date : null;\n    currentParty = inInvoice ? r.Particulars : null;\n    continue;\n  }\n\n  /* 2️⃣ Product rows under Tax Invoice */\n  if (\n    inInvoice &&\n    currentDate &&\n    currentParty &&\n    typeof r.Date === \"string\" &&\n    qtyRegex.test(String(r.Particulars || \"\")) &&\n    rateRegex.test(String(r[\"Vch Type\"] || \"\")) &&\n    typeof r[\"Vch No.\"] === \"number\"\n  ) {\n    output.push({\n      \"order date\": currentDate,\n      \"party name\": currentParty,\n      \"product\": r.Date,\n      \"quantity\": r.Particulars,\n      \"price/unit\": r[\"Vch Type\"],\n      \"order value\": r[\"Vch No.\"]\n    });\n  }\n}\n\nreturn output.map(o => ({ json: o }));\n"
      },
