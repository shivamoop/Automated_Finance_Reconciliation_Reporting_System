    {
      "parameters": {
        "jsCode": "const output = [];\n\nfor (const item of items) {\n  const d = item.json;\n  const excelDate = d[\"Mittal Corporation (2026-2027)\"];\n  const party = d[\"__EMPTY\"];\n  const vchType = d[\"__EMPTY_1\"];\n  const vchNo = d[\"__EMPTY_2\"];\n  const debit = d[\"__EMPTY_3\"] || 0;\n  const credit = d[\"__EMPTY_4\"] || 0;\n\n  // Skip junk rows (header rows or empty parties)\n  if (!party || typeof excelDate !== \"number\") continue;\n\n  // Updated filter: Now matches \"Credit Note\" as seen in your input data\n  if (![\"Sales\", \"Receipt\", \"Credit Note\"].includes(vchType)) continue;\n\n  // Convert Excel date\n  const orderDate = new Date((excelDate - 25569) * 86400 * 1000).toISOString().split(\"T\")[0];\n\n  output.push({\n    order_date: orderDate,\n    party_name: party,\n    voucher_type: vchType,\n    voucher_no: vchNo || null,\n    // Sales use Debit, Credit Notes and Receipts use Credit\n    bill_amount: vchType === \"Sales\" ? debit : null,\n    payment_received: (vchType === \"Receipt\" || vchType === \"Credit Note\") ? credit : null,\n    payment_mode: vchType === \"Receipt\" ? d[\"__EMPTY_2\"] : null\n  });\n}\n\nreturn output.map(o => ({ json: o }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        848
      ],
      "id": "9c15cf33-bd20-4c7c-9778-0deec61d2727",
      "name": "Normalising file1"
    },
