    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n\n  const party = String(item.json.party_name || \"\")\n    .trim()\n    .toLowerCase();\n\n  const date = new Date(item.json.order_date)\n    .toISOString()\n    .split(\"T\")[0];\n\n  const amount = Math.round(\n    Number(item.json.payment_received) * 100\n  ) / 100;\n\n  return {\n    json: {\n      receipt_key: `${party}|${date}|${amount}`,\n      party_name: item.json.party_name,\n      receipt_date: date,\n      receipt_amount: amount,\n      payment_mode: item.json.payment_mode || \"\",\n      status: \"PENDING\",\n      processed_at: \"\"\n    }\n  };\n});\n"
      },
