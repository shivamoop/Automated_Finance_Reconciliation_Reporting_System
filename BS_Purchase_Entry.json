    {
      "parameters": {
        "jsCode": "// Excel serial → ISO date converter\nfunction excelDateToISO(serial) {\n  if (typeof serial !== \"number\" || isNaN(serial)) return serial;\n  if (serial < 1 || serial > 100000) return serial; // Guard rail\n  const base = new Date(Date.UTC(1899, 11, 30));\n  return new Date(base.getTime() + serial * 86400000).toISOString().slice(0, 10);\n}\n\n// Variables to track the transaction context across multiple rows\nlet currentDate = null;\nlet currentParty = null;\nconst output = [];\n\n// Loop through rows (starting after the headers at index 7)\nfor (let i = 7; i < items.length; i++) {\n  const row = items[i].json;\n\n  // 1. Identify the main Voucher header row\n  const vchType = row[\"__EMPTY_5\"]; \n  if (vchType === \"Purchase\") {\n    currentDate = excelDateToISO(row[\"Mittal Corporation (2026-2027)\"]);\n    currentParty = row[\"__EMPTY\"];\n    continue; // Skip directly to the item lines below\n  }\n\n  // 2. Extract potential item breakdown details\n  const product = row[\"__EMPTY\"] ? String(row[\"__EMPTY\"]).trim() : \"\";\n  const quantity = row[\"__EMPTY_1\"];\n  const priceUnit = row[\"__EMPTY_2\"];\n  const orderValue = row[\"__EMPTY_3\"];\n\n  // 🛠️ FIX 1: List all words that indicate an accounting/reference row instead of an item\n  const ignoredKeywords = [\"New Ref\", \"PURCHASE - GST\", \"CGST\", \"SGST\", \"ROUND OFF\", \"Particulars\"];\n  const isIgnoredRow = ignoredKeywords.some(keyword => product.includes(keyword)) || !product;\n\n  // 🛠️ FIX 2: Ensure the price field looks like a real rate breakdown (e.g., contains a unit slash like \"/PCS\")\n  const hasValidRateFormat = priceUnit && String(priceUnit).includes(\"/\");\n\n  // Only push to output if it's a legitimate product row\n  if (currentDate && currentParty && !isIgnoredRow && hasValidRateFormat) {\n    output.push({\n      json: {\n        \"Date\": currentDate,\n        \"Party name\": currentParty,\n        \"Product\": product,\n        \"quantity\": quantity,\n        \"price/unit\": priceUnit,\n        \"order value\": orderValue\n      }\n    });\n  }\n}\n\nreturn output;"
      },
